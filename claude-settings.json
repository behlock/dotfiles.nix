{
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "claude-fable-5-1[1m]",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX\" ] && { tmux set-option -w -u -t \"$TMUX_PANE\" @claude-seen; a=$(tmux display -p -t \"$TMUX_PANE\" '#{window_active}'); style=; [ \"$a\" = \"1\" ] || style='#[fg=colour208,bold]'; tmux set-option -w -t \"$TMUX_PANE\" @claude-status \"$style\"; }; exit 0"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX\" ] && { a=$(tmux display -p -t \"$TMUX_PANE\" '#{window_active}'); seen=$(tmux show-options -w -v -t \"$TMUX_PANE\" @claude-seen 2>/dev/null); [ \"$a\" = \"1\" ] || [ \"$seen\" = \"1\" ] || tmux set-option -w -t \"$TMUX_PANE\" @claude-status '#[fg=green,bold]'; }; exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{ printf '\\a' > /dev/tty; } 2>/dev/null; [ -n \"$TMUX\" ] && tmux set-option -w -u -t \"$TMUX_PANE\" @claude-status; exit 0"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "vercel@claude-plugins-official": true
  },
  "effortLevel": "high",
  "promptSuggestionEnabled": false,
  "theme": "auto",
  "editorMode": "vim",
  "preferredNotifChannel": "iterm2",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
